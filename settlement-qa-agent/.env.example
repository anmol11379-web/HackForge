# AI Provider: "groq" | "gemini" | "mock"
AI_PROVIDER=groq

# Groq Configuration (get key from https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Server port
PORT=3001
