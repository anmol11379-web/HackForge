# LLM Provider Configuration
# Options: "auto" (default), "gemini", "groq", or "deterministic"
LLM_PROVIDER=auto

# Optional API Keys (leave blank to run in 100% free deterministic mode)
GEMINI_API_KEY=
GROQ_API_KEY=

# Model Names
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=llama3-70b-8192

# SLA Parameters
DEFAULT_SLA_DAYS=1
